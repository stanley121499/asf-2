# Supabase (same project as Next.js — use anon key only; never ship service_role in the app).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# LAN IP or deployed Next.js origin — required for `/api/*` routes (promotions, delivery, Stripe proxies).
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
