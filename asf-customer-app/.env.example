# Supabase (anon key — safe to embed in the app; RLS enforced server-side)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe publishable key (pk_test_... / pk_live_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Next.js app base URL (no trailing slash). Used for `/api/*` routes
# (rewards content-view, warranty, location, etc.).
#
# Production (preferred for physical iPhone once routes are deployed):
#   EXPO_PUBLIC_API_URL=https://asf-2.vercel.app
#   After changing this value: fully stop Metro, then `npx expo start --clear`.
#
# Local LAN alternate (Mac Next on same Wi‑Fi):
#   1. Run asf-2-next: `npm run dev -- --hostname 0.0.0.0 --port 3010`
#   2. Set host+port to match (`ipconfig getifaddr en0` on macOS). Example:
#         EXPO_PUBLIC_API_URL=http://192.168.x.x:3010
#      In __DEV__, a stale LAN IP is rewritten from Expo’s packager host while
#      keeping this port — still restart Metro after changing .env.
#   3. Phone and Mac must be on the same Wi‑Fi.
#
# Simulator / loopback: localhost is rewritten to Expo’s LAN host automatically.
EXPO_PUBLIC_API_URL=https://asf-2.vercel.app

# Public web origin used in password-reset emails (same host as Next.js deploy; no trailing slash).
# Must match redirect URLs configured in Supabase Auth settings.
EXPO_PUBLIC_APP_URL=https://asf-2.vercel.app

# Note: Never put secret keys (service role, Stripe secret, webhook secrets) in EXPO_PUBLIC_*.
