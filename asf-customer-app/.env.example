# Supabase (anon key — safe to embed in the app; RLS enforced server-side)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe publishable key (pk_test_... / pk_live_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Next.js app base URL (no trailing slash). Used for /api/* routes.
# Local LAN: http://192.168.x.x:3000
# Production: https://your-deployment.vercel.app
EXPO_PUBLIC_API_URL=http://192.168.1.1:3000

# Public web origin used in password-reset emails (same host as Next.js deploy; no trailing slash).
# Must match redirect URLs configured in Supabase Auth settings.
EXPO_PUBLIC_APP_URL=https://your-deployment.vercel.app

# Note: Never put secret keys (service role, Stripe secret, webhook secrets) in EXPO_PUBLIC_*.
