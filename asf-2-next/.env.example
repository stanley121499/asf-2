# =============================================================================
# asf-2-next — Environment Variables Reference
# =============================================================================
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored. This file (.env.example) is committed.
#
# NEXT_PUBLIC_* vars are bundled into the browser. Never put secrets here.
# All other vars are server-only (API routes, middleware, SSR).
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE — Public (safe to expose to browser)
# -----------------------------------------------------------------------------
# Found in: Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Found in: Supabase dashboard → Project Settings → API → anon / public key
# IMPORTANT: This must be the ANON key, NOT the service_role key.
# The anon key starts with: eyJ...  and decodes to "role":"anon"
# If yours decodes to "role":"service_role" — rotate it immediately in Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key-here


# -----------------------------------------------------------------------------
# SUPABASE — Server only (never expose to browser, never prefix NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# Found in: Supabase dashboard → Project Settings → API → service_role / secret key
# Used in: API route handlers (Stripe webhook, Delyva routes) to bypass RLS
# for trusted server operations (creating orders, inserting notifications, etc.)
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key-here


# -----------------------------------------------------------------------------
# STRIPE — Public (safe to expose to browser)
# -----------------------------------------------------------------------------
# Found in: Stripe dashboard → Developers → API keys → Publishable key
# Used in: Checkout page (<Elements> provider, <PaymentElement>)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...


# -----------------------------------------------------------------------------
# STRIPE — Server only
# -----------------------------------------------------------------------------
# Found in: Stripe dashboard → Developers → API keys → Secret key
# Used in: /api/stripe/create-payment-intent (server-side Stripe calls)
STRIPE_SECRET_KEY=sk_test_...

# Found in: Stripe dashboard → Developers → Webhooks → (your endpoint) → Signing secret
# Used in: /api/stripe/webhook (verify Stripe HMAC signature on every event)
# For local dev: use Stripe CLI → `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# The CLI prints a temporary whsec_... secret — use that during development
STRIPE_WEBHOOK_SECRET=whsec_...


# -----------------------------------------------------------------------------
# DELYVA — Server only
# -----------------------------------------------------------------------------
# Register at: https://trydx.delyva.app (sandbox) or https://my.delyva.app (production)
# Found in: Customer portal → Settings → API Integrations

DELYVA_API_KEY=...

# Found in the portal under your company profile
DELYVA_COMPANY_ID=...

# The customer ID tied to your API key (shown in portal settings)
DELYVA_CUSTOMER_ID=...

# Your warehouse / pickup address — used as the origin for all shipments and rate quotes
# Must be valid JSON on a single line
DELYVA_ORIGIN_ADDRESS={"address1":"Your Address Line 1","address2":"","city":"Your City","state":"Your State","postcode":"00000","country":"MY"}

# Sender contact details printed on the shipping label / AWB
DELYVA_SENDER_NAME=ASF Fulfillment
# Malaysian phone number on AWB (e.g. 60123456789 — no spaces, no +) — REQUIRED, create-shipment 500s without it
DELYVA_SENDER_PHONE=60123456789
# Optional — falls back to ADMIN_EMAIL if blank
DELYVA_SENDER_EMAIL=

# Shared secret for verifying Delyva webhook signatures (set when subscribing to webhooks)
DELYVA_WEBHOOK_SECRET=...


# -----------------------------------------------------------------------------
# APP CONFIG — Public
# -----------------------------------------------------------------------------
# The canonical URL of the deployed app (no trailing slash)
# Used in: Supabase Auth redirect URLs (password reset), Stripe return_url
# Supabase dashboard → Authentication → URL Configuration → Redirect URLs must include:
#   {NEXT_PUBLIC_APP_URL}/authentication/reset-password
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# For local development override:
# NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# APP CONFIG — Server only
# -----------------------------------------------------------------------------
# Bootstrap escape hatch for RBAC middleware (Step 12).
# A user whose Supabase auth email matches this is treated as admin even if
# they have no staff_roles row yet — lets you access /dashboard on first deploy.
# Remove or leave blank once you have a proper staff_roles row inserted.
ADMIN_EMAIL=your@email.com


# -----------------------------------------------------------------------------
# POINTS / REWARDS CONFIG — Public
# -----------------------------------------------------------------------------
# Percentage of order value converted to points (e.g. 5 = 5%)
NEXT_PUBLIC_POINTS_EARN_PERCENTAGE=5

# How many points equal 1 RM (e.g. 100 points = RM 1)
NEXT_PUBLIC_POINTS_PER_RM=100


# -----------------------------------------------------------------------------
# NOTE: Legacy CRA variable names below — DO NOT use in asf-2-next
# The following names are from the old Create React App project (asf-2/src).
# They do not work in Next.js. Keep them only if you are still running the CRA
# app in parallel; otherwise remove them.
# -----------------------------------------------------------------------------
# REACT_APP_STRIPE_PUBLIC_KEY=...   ← replaced by NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# REACT_APP_ENV=...                 ← use NODE_ENV (automatic in Next.js)
# REACT_APP_APP_URL=...             ← replaced by NEXT_PUBLIC_APP_URL
# REACT_APP_PORT=...                ← set via `next dev -p 3001` if needed
# REACT_APP_POINTS_EARN_PERCENTAGE  ← replaced by NEXT_PUBLIC_POINTS_EARN_PERCENTAGE
# REACT_APP_POINTS_PER_RM           ← replaced by NEXT_PUBLIC_POINTS_PER_RM
